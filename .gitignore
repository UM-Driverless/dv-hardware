# KiCad
*-backups/
*.bak
*.kicad_prl
*.kicad_pcb-bak
*-cache.lib
*.000
*.tmp
fp-info-cache
~*.lck
_autosave-*
# KiCad 10's local history feature creates .history/ with its own
# internal .git/ — once seen, git treats it as a submodule pointer
# and this rule alone won't unstage it (use git rm --cached too).
.history/
**/.history/

# EasyEDA source dir is a read-only archive — block any KiCad
# project files that get accidentally created there when KiCad
# opens an .epro and tries to make sibling .kicad_pro stubs.
projects/*/easyeda-source/*.kicad_*

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Build / fab outputs (generated, regenerate with kicad-cli)
# Uncomment if you decide not to track generated Gerbers:
# fab/**/gerbers/
# fab/**/*.zip
